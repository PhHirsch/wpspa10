      case "cactus": { const p = P0; return shadow(ax, ay, .7, .3) + `<g transform="translate(${f1(p[0])} ${f1(p[1])})"><path d="M-8 2 L-10 8 L10 8 L8 2 Z" fill="#c96a3a"/><rect x="-11" y="-1" width="22" height="4" rx="1" fill="#e0844e"/><path d="M-5 -1 L-5 -40 Q0 -46 5 -40 L5 -1 Z" fill="#3a9a4a"/><path d="M-5 -18 L-12 -18 Q-16 -18 -16 -22 L-16 -32 Q-12 -36 -9 -32 L-9 -24 L-5 -24 Z M5 -24 L12 -24 Q15 -24 15 -28 L15 -36 Q12 -40 9 -36 L9 -30 L5 -30 Z" fill="#3a9a4a"/><path d="M0 -42 L0 -2" stroke="#2a7a3a" stroke-width="1"/><circle cx="0" cy="-45" r="3.4" fill="#ff4f8b"/><g stroke="#f4f1ea" stroke-width=".8"><path d="M-6 -30 l-3 -1 M6 -14 l3 -1 M-6 -10 l-3 1 M6 -36 l3 -1"/></g></g>`; }
      case "perchero": { const p = P0; return shadow(ax, ay, 1, .35) + `<g transform="translate(${f1(p[0])} ${f1(p[1])})"><path d="M-26 4 L-22 -46 M26 4 L22 -46 M-24 -46 L24 -46" stroke="#5a5f68" stroke-width="2.6" fill="none"/><path d="M-30 4 L-20 4 M20 4 L30 4" stroke="#5a5f68" stroke-width="3"/>${[["-14","#e63946"],["0","#3a78d8"],["14","#f0c03a"]].map(([x,c])=>`<g transform="translate(${x} -46)"><path d="M0 0 L0 4 M-6 8 Q0 2 6 8" stroke="#888" stroke-width="1.2" fill="none"/><path d="M-7 8 L7 8 L9 30 L-9 30 Z" fill="${c}"/><path d="M-7 8 L-11 16 L-8 18 L-6 12 M7 8 L11 16 L8 18 L6 12" fill="${c}"/></g>`).join("")}</g>`; }
      case "piragua": { const p = P0; return shadow(ax, ay, 1.3, .35) + `<g transform="translate(${f1(p[0])} ${f1(p[1] - 4)})"><path d="M-34 0 Q0 12 34 0 Q0 -6 -34 0 Z" fill="#ff8a2a" stroke="#c8611a" stroke-width="1.5"/><ellipse cx="0" cy="-1" rx="9" ry="3" fill="#2a2a30"/><path d="M-22 -16 L22 10" stroke="#5a5f68" stroke-width="2.4"/><path d="M-26 -18 L-18 -14 L-20 -10 Z M18 8 L26 12 L22 14 Z" fill="#3a78d8"/></g>`; }
      case "escenario": { const p = P0; return shadow(ax, ay, 1.4, .55) + `<g transform="translate(${f1(p[0])} ${f1(p[1])})"><path d="M-34 0 L34 0 L34 -10 L-34 -10 Z" fill="#5a3a2a"/><path d="M-34 -10 L34 -10 L28 -16 L-28 -16 Z" fill="#8a5a3a"/><path d="M-32 -16 L-32 -52 M32 -16 L32 -52 M-32 -52 L32 -52" stroke="#2a2a30" stroke-width="3"/><circle cx="-18" cy="-48" r="3" fill="#ffd23a"/><circle cx="0" cy="-48" r="3" fill="#ff4f8b"/><circle cx="18" cy="-48" r="3" fill="#3ab0ff"/><rect x="-20" y="-30" width="12" height="12" rx="2" fill="#2a2a30"/><circle cx="-14" cy="-24" r="4" fill="#5a5f68"/><path d="M8 -16 L12 -34" stroke="#c8312b" stroke-width="3"/><path d="M6 -36 L14 -32 L18 -40" stroke="#c8312b" stroke-width="2" fill="none"/><path d="M20 -16 L20 -30 M16 -30 L24 -30" stroke="#888" stroke-width="2"/></g>`; }
      case "horreo": { const p = P0; return shadow(ax, ay, 1.3, .45) + `<g transform="translate(${f1(p[0])} ${f1(p[1])})">${[-22, 0, 22].map(x => `<rect x="${x - 3}" y="-14" width="6" height="14" fill="#9a9aa0"/><ellipse cx="${x}" cy="-15" rx="6" ry="2.4" fill="#b8b8c0"/>`).join("")}<rect x="-30" y="-40" width="60" height="24" fill="#c9a878" stroke="#8a6a4a" stroke-width="1.5"/>${[-22, -14, -6, 2, 10, 18, 26].map(x => `<path d="M${x} -38 L${x} -18" stroke="#8a6a4a" stroke-width="1.6"/>`).join("")}<path d="M-34 -40 L0 -56 L34 -40 Z" fill="#b84a2a"/><path d="M-4 -60 L4 -60 L2 -54 L-2 -54 Z M0 -66 L0 -58 M-4 -63 L4 -63" stroke="#9a9aa0" stroke-width="2" fill="#9a9aa0"/></g>`; }
      case "faro": { const p = P0; return shadow(ax, ay, 1.1, .45) + `<g transform="translate(${f1(p[0])} ${f1(p[1])})"><path d="M-16 0 L-12 -8 L12 -8 L16 0 Z" fill="#6a6a72"/><path d="M-10 -8 L-7 -60 L7 -60 L10 -8 Z" fill="#f4f1ea" stroke="#b8b0a0"/><path d="M-9.5 -22 L9.5 -22 L9 -30 L-9 -30 Z M-8 -44 L8 -44 L7.6 -52 L-7.6 -52 Z" fill="#c8312b"/><rect x="-6" y="-70" width="12" height="10" fill="#fff6a0" stroke="#5a5f68"/><path d="M-8 -70 L0 -78 L8 -70 Z" fill="#2a2a30"/><path d="M6 -66 L36 -76 L36 -56 Z" fill="#fff6a0" opacity=".45"><animate attributeName="opacity" values=".1;.6;.1" dur="2.4s" repeatCount="indefinite"/></path></g>`; }
      case "puesto": { let r = shadow(ax, ay, 1.2, .55) + blk(ax - .8, ay - .4, 0, 1.6, .8, .7, "#c9a878") + blk(ax - .8, ay - .4, .7, 1.6, .8, .06, "#8a6a4a"); r += ln([ax - .75, ay + .35, .76], [ax - .75, ay + .35, 1.8], "#8a6a4a", 1.6) + ln([ax + .75, ay + .35, .76], [ax + .75, ay + .35, 1.8], "#8a6a4a", 1.6); for (let i = 0; i < 4; i++) r += poly([[ax - .9 + i * .45, ay + .5, 1.65], [ax - .45 + i * .45, ay + .5, 1.65], [ax - .45 + i * .45, ay - .4, 1.95], [ax - .9 + i * .45, ay - .4, 1.95]], i % 2 ? "#ffffff" : "#2a9a4a"); r += ball(ax - .45, ay + .1, .82, .17, "#e63946") + ball(ax - .2, ay + .15, .82, .17, "#ff8a2a") + ball(ax + .1, ay + .1, .82, .17, "#ffd23a") + ball(ax + .4, ay + .12, .82, .17, "#6a3a1a"); const q = P(ax, ay + .4, .4); return r + `<text x="${f1(q[0])}" y="${f1(q[1])}" font-size="6" font-family="Arial" font-weight="800" fill="#3a2a10" text-anchor="middle">FRUTERÍA</text>`; }
      case "bici": { const p = P0; return shadow(ax, ay, 1, .3) + `<g transform="translate(${f1(p[0])} ${f1(p[1] - 11)})" fill="none" stroke-linecap="round"><circle cx="-13" cy="0" r="10" stroke="#222" stroke-width="2.4"/><circle cx="13" cy="0" r="10" stroke="#222" stroke-width="2.4"/><path d="M-13 0 L-3 -14 L10 -14 L13 0 M-3 -14 L0 0 L10 -14 M0 0 L-13 0" stroke="#e63946" stroke-width="2.6"/><path d="M-6 -17 L0 -17 M10 -14 L8 -20 L13 -21" stroke="#333" stroke-width="2.4"/></g>`; }
      case "helados": { let r = shadow(ax, ay, 1.1, .5) + blk(ax - .7, ay - .35, .2, 1.4, .7, .8, "#fdf3f7") + blk(ax - .7, ay - .35, .95, 1.4, .7, .06, "#ff7eb6") + ball(ax - .75, ay + .4, .22, .2, "#333") + ball(ax + .55, ay + .4, .22, .2, "#333"); r += ln([ax, ay, 1], [ax, ay, 2.2], "#ccc", 1.8); const p = P(ax, ay, 2.2), q = P(ax + .3, ay + .35, .6); return r + `<path d="M${f1(p[0] - 24)} ${f1(p[1] + 8)} Q${f1(p[0])} ${f1(p[1] - 12)} ${f1(p[0] + 24)} ${f1(p[1] + 8)} Z" fill="#4fc3e8"/><g transform="translate(${f1(q[0])} ${f1(q[1])})"><path d="M-4 0 L0 9 L4 0 Z" fill="#d9a44a"/><circle cx="0" cy="-2" r="4.5" fill="#ff9ac8"/></g>`; }
      case "metro": { let r = poly([[ax - .8, ay - .5, .02], [ax + .5, ay - .5, .02], [ax + .5, ay + .5, .02], [ax - .8, ay + .5, .02]], "#3a3f48"); for (let i = 0; i < 4; i++) r += poly([[ax - .7 + i * .3, ay - .45, .03 + 0], [ax - .55 + i * .3, ay - .45, .03], [ax - .55 + i * .3, ay + .45, .03], [ax - .7 + i * .3, ay + .45, .03]], "#5a606c"); r += blk(ax - .85, ay - .55, 0, 1.4, .06, .55, "#9aa0aa") + blk(ax - .85, ay + .5, 0, 1.4, .06, .55, "#9aa0aa"); r += ln([ax + .75, ay, 0], [ax + .75, ay, 2.2], "#555", 2); const p = P(ax + .75, ay, 2.3); return shadow(ax, ay, 1.1, .5) + r + `<g transform="translate(${f1(p[0])} ${f1(p[1])})"><rect x="-15" y="-9" width="30" height="16" rx="3" fill="#d8262e" stroke="#fff" stroke-width="1.5"/><text x="0" y="3" font-size="8" font-family="Arial" font-weight="800" fill="#fff" text-anchor="middle">METRO</text></g>`; }
      case "churros": { let r = shadow(ax, ay, 1.2, .55) + blk(ax - .8, ay - .4, 0, 1.6, .8, .85, "#f6e2c0") + blk(ax - .8, ay - .4, .85, 1.6, .8, .06, "#8a5a2a"); r += ln([ax - .75, ay + .35, .9], [ax - .75, ay + .35, 1.9], "#8a5a2a", 1.6) + ln([ax + .75, ay + .35, .9], [ax + .75, ay + .35, 1.9], "#8a5a2a", 1.6); for (let i = 0; i < 4; i++) r += poly([[ax - .9 + i * .45, ay + .5, 1.75], [ax - .45 + i * .45, ay + .5, 1.75], [ax - .45 + i * .45, ay - .4, 2.05], [ax - .9 + i * .45, ay - .4, 2.05]], i % 2 ? "#ffffff" : "#e63946"); const p = P(ax, ay + .4, .5), c = P(ax + .45, ay, .95); return r + `<text x="${f1(p[0])}" y="${f1(p[1])}" font-size="6" font-family="Arial" font-weight="800" fill="#8a3a1a" text-anchor="middle">CHURROS</text><g transform="translate(${f1(c[0])} ${f1(c[1])})"><path d="M-4 -6 L4 -6 L3 0 L-3 0 Z" fill="#5a2a14"/><path d="M-1 -6 q4 -8 1 -13" stroke="#d9a44a" stroke-width="2.2" fill="none" stroke-linecap="round"/></g>`; }
      case "liberty": { const p = P0; return shadow(ax, ay, .8, .35) + blk(ax - .4, ay - .4, 0, .8, .8, .8, "#b8b2a6") + `<g transform="translate(${f1(p[0])} ${f1(p[1] - 16)})"><path d="M-6 0 l2 -30 q4 -6 8 0 l2 30z" fill="#6fb8a2"/><circle cx="0" cy="-34" r="5" fill="#6fb8a2"/><path d="M-6 -38 l-3 -6 M-2 -40 l-1 -7 M2 -40 l1 -7 M6 -38 l3 -6" stroke="#6fb8a2" stroke-width="2"/><path d="M4 -26 l6 -18" stroke="#6fb8a2" stroke-width="3"/><path d="M9 -46 q3 -6 0 -9 q-3 3 0 9z" fill="#ffb02e"/></g>`; }
      case "amish": { let r = shadow(ax + .2, ay, 1.4, .6); const x0 = ax - .9, y0 = ay - .7; r += blk(x0, y0, 0, 1.3, 1.1, 1, "#a8322a"); r += poly([[x0 - .1, y0 - .1, 1], [x0 + 1.4, y0 - .1, 1], [x0 + 1.4, y0 + .55, 1.6], [x0 - .1, y0 + .55, 1.6]], "#3a3a3a") + poly([[x0 + 1.3, y0, 1], [x0 + 1.3, y0 + 1.1, 1], [x0 + 1.3, y0 + .55, 1.6]], "#8a2a22") + poly([[x0 - .1, y0 + 1.2, 1], [x0 + 1.4, y0 + 1.2, 1], [x0 + 1.4, y0 + .55, 1.6], [x0 - .1, y0 + .55, 1.6]], "#4a4a4a"); const F = face([x0, y0 + 1.1, 0], [1, 0, 0], [0, 0, 1]); r += fpoly(F, [[.35, 0], [.95, 0], [.95, .75], [.35, .75]], "none", 'stroke="#fff" stroke-width="2"') + fln(F, [.35, 0], [.95, .75], "#fff", 1.6) + fln(F, [.95, 0], [.35, .75], "#fff", 1.6); r += blk(ax + .6, ay + .2, .35, .7, .5, .55, "#1a1a1a") + ball(ax + .65, ay + .75, .25, .25, "none", 'stroke="#333" stroke-width="2"') + ball(ax + 1.25, ay + .75, .25, .25, "none", 'stroke="#333" stroke-width="2"'); return r; }
      case "ggbridge": { let r = disc(ax, ay, .01, 1.1, "#4a9ad8") ; r += blk(ax - 1.2, ay - .15, .3, 2.4, .3, .1, "#c0362c"); [-.7, .7].forEach(dx => r += blk(ax + dx - .08, ay - .2, 0, .16, .4, 1.7, "#c0362c")); const a = P(ax - 1.2, ay, .4), b = P(ax - .7, ay, 1.7), c = P(ax + .7, ay, 1.7), d = P(ax + 1.2, ay, .4), m = P(ax, ay, .6); r += `<path d="M${f1(a[0])} ${f1(a[1])} Q${f1((a[0] + b[0]) / 2)} ${f1(b[1] + 4)} ${f1(b[0])} ${f1(b[1])} Q${f1(m[0])} ${f1(m[1])} ${f1(c[0])} ${f1(c[1])} Q${f1((c[0] + d[0]) / 2)} ${f1(c[1] + 4)} ${f1(d[0])} ${f1(d[1])}" fill="none" stroke="#c0362c" stroke-width="1.8"/>`; return r; }
      case "walkstar": { let r = poly([[ax - .7, ay - .7, .02], [ax + .7, ay - .7, .02], [ax + .7, ay + .7, .02], [ax - .7, ay + .7, .02]], "#d9a0b6"); const st = []; for (let i = 0; i < 10; i++) { const t = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? .22 : .5; st.push([ax + Math.cos(t) * rr, ay + Math.sin(t) * rr, .03]); } r += poly(st, "#e2b23a", 'stroke="#fff6c8" stroke-width="1"'); return r; }
      case "robot": { let r = shadow(ax, ay, .6, .3) + blk(ax - .1, ay - .1, 0, .2, .2, .3, "#888") + blk(ax - .35, ay - .25, .3, .7, .5, .7, "#c9d0da") + blk(ax - .25, ay - .2, 1, .5, .4, .4, "#dde3ea"); const p = P(ax, ay + .2, 1.2); r += `<circle cx="${f1(p[0] - 4)}" cy="${f1(p[1])}" r="2.2" fill="#3ff0ff"/><circle cx="${f1(p[0] + 4)}" cy="${f1(p[1])}" r="2.2" fill="#3ff0ff"/><line x1="${f1(p[0] + 4)}" y1="${f1(p[1] - 12)}" x2="${f1(p[0] + 4)}" y2="${f1(p[1] - 22)}" stroke="#888" stroke-width="1.5"/><circle cx="${f1(p[0] + 4)}" cy="${f1(p[1] - 23)}" r="2.5" fill="#ff4d4d"><animate attributeName="opacity" values="1;.2;1" dur="1s" repeatCount="indefinite"/></circle>`; return r; }
    }
    return s;
  }

  /* ---------- Untergrund, Weg, Zaun ---------- */
  function ground(kind, col) {
    let s = "";
    const side = kind === "snow" ? "#9a7a5a" : kind === "moon" ? "#7a7d86" : kind === "lava" ? "#2a1a1a" : kind === "candy" ? "#e07aa8" : "#8a5a32";
    s += poly([[0, N, 0], [N, N, 0], [N, N, -.8], [0, N, -.8]], sh(side, .95)) + poly([[N, 0, 0], [N, N, 0], [N, N, -.8], [N, 0, -.8]], sh(side, .75));
    s += poly([[0, 0, 0], [N, 0, 0], [N, N, 0], [0, N, 0]], col);
    const R = rng(11);
    if (kind === "grass" || kind === "meadow" || kind === "weser") for (let i = 0; i < 60; i++) { const x = R() * N, y = R() * N; s += ln([x, y, 0], [x + .05, y, .18], sh(col, .75), 1.2); }
    if (kind === "meadow") { const C = ["#ffffff", "#ffd23a", "#ff8fb8", "#b36bff"]; for (let i = 0; i < 45; i++) s += ball(R() * N, R() * N, .05, .07, C[i % 4]); }
    if (kind === "autumn") { const C = ["#e07a2a", "#c8452a", "#e9b23a", "#8a5a2a"]; for (let i = 0; i < 70; i++) s += ball(R() * N, R() * N, .02, .08, C[i % 4]); }
    if (kind === "snow") for (let i = 0; i < 40; i++) s += ball(R() * N, R() * N, .02, .12, "#dfe9f3");
    if (kind === "desert") { for (let i = 0; i < 30; i++) s += ball(R() * N, R() * N, .02, .06, "#c9a05a"); const p = P(1, 8.8, 0); s += `<g transform="translate(${f1(p[0])} ${f1(p[1])})"><path d="M-3 0 v-28 a3 3 0 0 1 6 0 v28z M3 -16 h5 v-8 a2.5 2.5 0 0 1 5 0 v10 h-10z M-3 -12 h-5 v-6 a2.5 2.5 0 0 0 -5 0 v8 h10z" fill="#3f8a45"/></g>`; }
    if (kind === "moon") for (let i = 0; i < 14; i++) { const x = .5 + R() * (N - 1), y = .5 + R() * (N - 1), r = .15 + R() * .35; s += disc(x, y, .01, r, "#9a9da6", 'stroke="#d0d3da" stroke-width="1"', 12); }
    if (kind === "candy") { const C = ["#ff5d8f", "#7ad7ff", "#ffe08a", "#b5f0a0"]; for (let i = 0; i < 40; i++) s += ball(R() * N, R() * N, .03, .1, C[i % 4]); }
    if (kind === "lava") for (let i = 0; i < 12; i++) { const x = R() * N, y = R() * N; s += ln([x, y, 0], [x + R() * 1.6 - .8, y + R() * 1.6 - .8, 0], "#ff6a1a", 2.2, `opacity=".8"`).replace("/>", `><animate attributeName="opacity" values=".9;.35;.9" dur="${2 + R()}s" repeatCount="indefinite"/></line>`); }
    if (kind === "weser" || kind === "beach") {
      const w = kind === "beach" ? 2.2 : 1.5, c = kind === "beach" ? "#2fa6d6" : "#4a8ec4";
      if (kind === "beach") s += poly([[N - w - .6, 0, 0], [N - w, 0, 0], [N - w, N, 0], [N - w - .6, N, 0]], "#f3e2ae");
      s += poly([[N - w, 0, .01], [N, 0, .01], [N, N, .01], [N - w, N, .01]], c) + poly([[N, 0, 0], [N, N, 0], [N, N, -.8], [N, 0, -.8]], sh(c, .7)) + poly([[N - w, N, 0], [N, N, 0], [N, N, -.8], [N - w, N, -.8]], sh(c, .85));
      for (let i = 0; i < 6; i++) { const y = .8 + i * 1.5; s += ln([N - w + .3, y, .02], [N - .3, y + .4, .02], "#ffffff", 1.4, 'opacity=".5"').replace("/>", `><animateTransform attributeName="transform" type="translate" values="0 0;-6 3;0 0" dur="${3 + i % 3}s" repeatCount="indefinite"/></line>`); }
    }
    return s;
  }
  function fence(it, waterW, doorX) {
    if (!it || !it.kind) return { right: "", front: "" };
    const k = it.kind, c = it.color, endX = N - (waterW || 0) - .2;
    const seg = (a, b) => {
      let s = "", L = Math.hypot(b[0] - a[0], b[1] - a[1]), n = Math.max(1, Math.round(L / .5));
      const at = t => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
      if (k === "hedge") { for (let i = 0; i < n; i++) { const p = at((i + .5) / n); s += ball(p[0], p[1], .35, .32, sh(c, .85 + (i % 2) * .15)); } return s; }
      if (k === "stone") { const d = [b[0] - a[0], b[1] - a[1]]; return blk(Math.min(a[0], b[0]) - (d[0] ? 0 : .15), Math.min(a[1], b[1]) - (d[1] ? 0 : .15), 0, Math.abs(d[0]) || .3, Math.abs(d[1]) || .3, .5, c); }
      for (let i = 0; i <= n; i++) { const p = at(i / n); s += ln([p[0], p[1], 0], [p[0], p[1], .65], sh(c, .9), 2.2); }
      s += ln([a[0], a[1], .45], [b[0], b[1], .45], sh(c, .8), 1.8) + ln([a[0], a[1], .2], [b[0], b[1], .2], sh(c, .8), 1.8);
      if (k === "lights") { const C = ["#ff4d4d", "#ffd23a", "#4dff88", "#4dc3ff"]; for (let i = 0; i < n * 2; i++) { const p = at((i + .5) / (n * 2)); s += ball(p[0], p[1], .6, .06, C[i % 4]).replace("/>", `><animate attributeName="opacity" values="1;.3;1" dur="${1 + i % 3 * .4}s" repeatCount="indefinite"/></circle>`); } }
      return s;
    };
    const right = waterW ? "" : seg([N - .15, .2], [N - .15, N - .2]);
    const front = seg([.2, N - .15], [doorX - .6, N - .15]) + seg([doorX + .6, N - .15], [endX, N - .15]);
    return { right: right, front: front };
  }

  /* ---------- Bauplan je Ausbaustufe ---------- */
  function plan(stage) {
    switch (stage) {
      case 0: return { tent: true };
      case 1: return { parts: [{ x: 1.6, y: 1.6, dx: 3.2, dy: 2.6, dz: 2.2, door: true }] };
      case 2: return { parts: [{ x: 1.2, y: 1.2, dx: 4.2, dy: 3.2, dz: 2.8, door: true }] };
      case 3: return { parts: [{ x: 1.0, y: 1.0, dx: 4.4, dy: 3.4, dz: 4.8, floors: 2, door: true }] };
      case 4: return { parts: [{ x: 0.9, y: 0.9, dx: 4.4, dy: 3.4, dz: 4.8, floors: 2, door: true }, { x: 5.3, y: 1.5, dx: 2.4, dy: 2.2, dz: 2.8, wing: true }] };
      case 5: return { parts: [{ x: 0.8, y: 0.8, dx: 4.8, dy: 3.6, dz: 5.2, floors: 2, door: true }, { x: 5.6, y: 1.4, dx: 2.4, dy: 2.4, dz: 3.0, wing: true }], porch: true };
      default: return { parts: [{ x: 1.2, y: 0.8, dx: 4.6, dy: 3.6, dz: 5.6, floors: 2, door: true }, { x: 5.8, y: 1.4, dx: 2.4, dy: 2.4, dz: 3.0, wing: true }], porch: true, tower: [1.0, 4.3, .85, 7.2] };
    }
  }
  const ANCHOR = { yard1: [1.6, 7.6], yard2: [4.9, 7.9], yard3: [7.2, 7.0], yard4: [7.4, 4.8] };

  /* ---------- Gesamtbild ---------- */
  function houseSVG(h0, stars, opts) {
    opts = opts || {};
    const h = hclean(h0), stage = opts.stage != null ? opts.stage : stageOf(stars || 0);
    const it = k => byId[h[k]];
    const gk = it("ground").kind, waterW = gk === "weser" ? 1.5 : gk === "beach" ? 2.2 : 0;
    const pl = plan(stage), main = pl.parts ? pl.parts[0] : null;
    const doorX = main ? main.x + main.dx / 2 : 3.7;
    let s = ground(gk, it("ground").color);
    // Weg zur Tür
    const yStart = main ? main.y + main.dy : 4.8;
    for (let y = yStart + .2; y < N - .1; y += .55) s += poly([[doorX - .38, y, .01], [doorX + .38, y, .01], [doorX + .38, y + .42, .01], [doorX - .38, y + .42, .01]], "#c9c2b0", 'stroke="#a8a090" stroke-width=".6"');
    const F = fence(it("fence").price != null && it("fence").kind ? it("fence") : null, waterW, doorX);
    s += F.right;
    // Garten hinten (yard4) vor dem Haus zeichnen, wenn es dahinter liegt
    const yards = ["yard1", "yard2", "yard3", "yard4"].filter(k => yardOpen(k, stage) && h[k] !== "y-none");
    if (yards.indexOf("yard4") >= 0 && !(pl.parts && pl.parts[1])) s += yard(it("yard4").kind, ANCHOR.yard4[0], ANCHOR.yard4[1]);
    if (pl.tent) s += tent(h);
    if (pl.parts) {
      const m = pl.parts[0];
      s += building(m, h);
      s += roofExtra(it("roofx").kind, roof(m, h, { info: true }));
      if (pl.parts[1]) { const w = Object.assign({}, pl.parts[1]); s += building(w, h); }
      if (pl.porch) { const x = doorX - 1.1, y = m.y + m.dy; s += blk(x, y, 0, 2.2, 1.2, .15, "#d6d2c8") + blk(x + .05, y + 1.0, .15, .14, .14, 2.3, "#f4f4f2") + blk(x + 2.0, y + 1.0, .15, .14, .14, 2.3, "#f4f4f2") + blk(x - .1, y, 2.45, 2.4, 1.3, .18, sh(it("rcolor").color, 1)); }
      if (pl.tower) s += tower(pl.tower[0], pl.tower[1], pl.tower[2], pl.tower[3], h);
    }
    if (yards.indexOf("yard4") >= 0 && pl.parts && pl.parts[1]) s += yard(it("yard4").kind, ANCHOR.yard4[0], ANCHOR.yard4[1]);
    ["yard1", "yard3", "yard2"].forEach(k => { if (yards.indexOf(k) >= 0) s += yard(it(k).kind, ANCHOR[k][0], ANCHOR[k][1]); });
    s += F.front;
    // Namensschild mit Avatar
    if (opts.avatar || opts.nr) {
      const p = P(doorX + 1.3, N - .55, 0);
      s += `<g transform="translate(${f1(p[0])} ${f1(p[1])})"><line x1="0" y1="0" x2="0" y2="-26" stroke="#6b4226" stroke-width="3"/>` +
        (opts.avatar ? `<circle cx="0" cy="-44" r="19" fill="#fff"/><svg x="-17" y="-61" width="34" height="34" viewBox="0 0 200 200"><clipPath id="nc${opts.uid || 0}"><circle cx="100" cy="100" r="100"/></clipPath><g clip-path="url(#nc${opts.uid || 0})">${opts.avatar.replace(/^<svg[^>]*>/, "").replace(/<\/svg>$/, "")}</g></svg>` : "") +
        (opts.nr ? `<rect x="-17" y="-28" width="34" height="13" rx="3" fill="#2a1a10"/><text x="0" y="-18" font-size="10" font-weight="800" font-family="Arial" fill="#ffd23a" text-anchor="middle">#${opts.nr}</text>` : "") + `</g>`;
    }
    if (opts.inner) return s;
    return `<svg viewBox="-180 -170 360 390" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%;height:auto">${s}</svg>`;
  }

  /* ---------- Stadt: alle Häuser auf einer Karte ---------- */
  function townSVG(list) {
    const n = list.length, C = Math.max(2, Math.ceil(Math.sqrt(n))), R = Math.max(1, Math.ceil(n / C)), G = 12.5;
    const W = C * G + 1.5, D = R * G + 1.5;
    const T = (x, y, z) => P(x, y, z || 0);
    let s = "";
    // Grundfläche mit Straßen und Weser
    const pp = a => a.map(q => { const p = T(q[0], q[1], q[2]); return f1(p[0]) + "," + f1(p[1]); }).join(" ");
    s += `<polygon points="${pp([[-1.5, -1.5, 0], [W, -1.5, 0], [W, D, 0], [-1.5, D, 0]])}" fill="#5c6670"/>`;
    s += `<polygon points="${pp([[-1.5, D, 0], [W, D, 0], [W, D, -1], [-1.5, D, -1]])}" fill="#4a3a2a"/><polygon points="${pp([[W, -1.5, 0], [W, D, 0], [W, D, -1], [W, -1.5, -1]])}" fill="#3a2e22"/>`;
    s += `<polygon points="${pp([[W, -1.5, 0], [W + 5, -1.5, 0], [W + 5, D, 0], [W, D, 0]])}" fill="#4a8ec4"/><polygon points="${pp([[W + 5, -1.5, 0], [W + 5, D, 0], [W + 5, D, -1], [W + 5, -1.5, -1]])}" fill="#356a96"/><polygon points="${pp([[W, D, 0], [W + 5, D, 0], [W + 5, D, -1], [W, D, -1]])}" fill="#3f7aaa"/>`;
    for (let i = 0; i < 8; i++) { const y = i * D / 8 + 1; s += ln([W + 1, y, .02], [W + 4, y + .8, .02], "#ffffff", 2, 'opacity=".45"'); }
    const tw = T(W + 2.5, D / 2, 0); s += `<text x="${f1(tw[0])}" y="${f1(tw[1])}" font-size="40" font-weight="800" fill="#ffffff" opacity=".6" text-anchor="middle" font-family="Arial" transform="rotate(30 ${f1(tw[0])} ${f1(tw[1])})">WESER</text>`;
    for (let i = 0; i <= C; i++) { const x = i * G - 1.25; s += ln([x, -1.5, .01], [x, D, .01], "#e9e2c8", 1.5, 'stroke-dasharray="12 10" opacity=".7"'); }
    for (let j = 0; j <= R; j++) { const y = j * G - 1.25; s += ln([-1.5, y, .01], [W, y, .01], "#e9e2c8", 1.5, 'stroke-dasharray="12 10" opacity=".7"'); }
    const cells = list.map((h, k) => ({ h: h, i: k % C, j: Math.floor(k / C), k: k })).sort((a, b) => (a.i + a.j) - (b.i + b.j) || a.i - b.i);
    cells.forEach(c => { const o = T(c.i * G, c.j * G, 0); s += `<g class="lot" data-k="${c.k}" style="cursor:pointer" transform="translate(${f1(o[0])} ${f1(o[1])})">${houseSVG(c.h.h, c.h.st, { nr: c.h.nr, inner: true })}</g>`; });
    const xs = [T(-1.5, D, 0)[0] - 20, T(W + 5, -1.5, 0)[0] + 20], ys = [T(-1.5, -1.5, 0)[1] - 230, T(W + 5, D, -1)[1] + 20];
    return `<svg viewBox="${f1(xs[0])} ${f1(ys[0])} ${f1(xs[1] - xs[0])} ${f1(ys[1] - ys[0])}" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%;height:auto">${s}</svg>`;
  }

  /* ---------- Stadt-Helfer ---------- */
  function tree(x, y, sc) { sc = sc || 1; return shadow(x, y, .7 * sc, .35 * sc) + ln([x, y, 0], [x, y, 1.1 * sc], "#6a4422", 3.5 * sc) + ball(x, y, 1.6 * sc, .75 * sc, "#3f8f3f") + ball(x - .2, y - .2, 1.85 * sc, .45 * sc, "#5fb25a"); }
  function lamp(x, y) { return ln([x, y, 0], [x, y, 2.1], "#3a3f48", 2.2) + ball(x, y, 2.2, .18, "#ffe9a0", 'stroke="#c9a84a" stroke-width="1"'); }
  function car(x, y, c, along) { const dx = along ? 1.6 : .8, dy = along ? .8 : 1.6; return shadow(x + dx / 2, y + dy / 2, .9, .45) + blk(x, y, .15, dx, dy, .45, c) + blk(x + (along ? .35 : .1), y + (along ? .1 : .35), .6, along ? .8 : .6, along ? .6 : .8, .3, "#dfe8f0"); }
  /* Kursplatz = Meta común: der Leuchtturm (gleiche Stufen wie im Lobby-Banner) */
  const METAS = [500, 1500, 3000, 6000, 10000, 15000];
  function plaza(ox, oy, meta) {
    const m = meta || 0, on = k => m >= METAS[k];
    let s = poly([[ox, oy, .02], [ox + 10, oy, .02], [ox + 10, oy + 10, .02], [ox, oy + 10, .02]], "#e3d3ad");
    s += disc(ox + 5, oy + 5, .03, 4.3, "#4a8ec4", 'stroke="#c9b98a" stroke-width="3"', 28);
    for (let r = 1.6; r < 4; r += 1) s += disc(ox + 5, oy + 5, .035, r, "none", 'stroke="#fff" stroke-width="1.2" opacity=".25"', 28);
    if (!on(0)) { // Baustelle
      s += blk(ox + .6, oy + .6, 0, .2, 8.8, .6, "#ff9a2a") + blk(ox + .6, oy + .6, 0, 8.8, .2, .6, "#ff9a2a");
      s += ball(ox + 5, oy + 5, .2, .9, "#8a8f98") + ball(ox + 5.8, oy + 4.6, .15, .6, "#9aa0a8");
      const t = P(ox + 5, oy + 5, 1.2); s += `<text x="${f1(t[0])}" y="${f1(t[1])}" font-size="34" text-anchor="middle">🚧</text>`;
    } else { // Felsen
      [[4.2, 5.8, .9, "#7a7f88"], [5.9, 5.6, .8, "#8a8f98"], [5.2, 4.2, .85, "#6f747c"], [3.9, 4.4, .6, "#9aa0a8"], [6.3, 4.3, .55, "#80858d"], [5, 5, 1.05, "#868b93"]].forEach(q => { s += ball(ox + q[0], oy + q[1], .25, q[2], q[3]); });
    }
    if (on(1)) { // Bänke und Bäume am Ufer
      [[1, 1], [9, 1], [1, 9]].forEach(q => { s += tree(ox + q[0], oy + q[1], 1); });
      s += blk(ox + 8.4, oy + 7.2, .3, .5, 1.6, .1, "#8a5a2a") + blk(ox + 7.2, oy + 8.6, .3, 1.6, .5, .1, "#8a5a2a");
    }
    const b0 = P(ox + 5, oy + 5, .9), bx = f1(b0[0]), by = b0[1];
    if (on(1)) s += `<path d="M${f1(b0[0] - 30)} ${f1(by)} L${f1(b0[0] - 26)} ${f1(by - 14)} L${f1(b0[0] + 26)} ${f1(by - 14)} L${f1(b0[0] + 30)} ${f1(by)} Q${bx} ${f1(by + 10)} ${f1(b0[0] - 30)} ${f1(by)} Z" fill="#8a8a92" stroke="#5a5f68" stroke-width="1.5"/><ellipse cx="${bx}" cy="${f1(by - 14)}" rx="26" ry="7" fill="#a4a4ac"/>`;
    const tb = by - 14, H = 112;
    if (on(2)) {
      s += `<path d="M${f1(b0[0] - 18)} ${f1(tb)} L${f1(b0[0] - 12)} ${f1(tb - H)} L${f1(b0[0] + 12)} ${f1(tb - H)} L${f1(b0[0] + 18)} ${f1(tb)} Z" fill="#f4f1ea" stroke="#b8b0a0" stroke-width="1.5"/>`;
      [[.18, .32], [.52, .66]].forEach(([u, v]) => { const w = f => 18 - 6 * f; s += `<path d="M${f1(b0[0] - w(u))} ${f1(tb - H * u)} L${f1(b0[0] - w(v))} ${f1(tb - H * v)} L${f1(b0[0] + w(v))} ${f1(tb - H * v)} L${f1(b0[0] + w(u))} ${f1(tb - H * u)} Z" fill="#c8312b"/>`; });
      s += `<path d="M${f1(b0[0] + 6)} ${f1(tb - H + 2)} L${f1(b0[0] + 9)} ${f1(tb - 2)} L${f1(b0[0] + 15)} ${f1(tb - 2)} L${f1(b0[0] + 11)} ${f1(tb - H + 2)} Z" fill="#000" opacity=".1"/><rect x="${f1(b0[0] - 4)}" y="${f1(tb - 18)}" width="8" height="14" rx="4" fill="#5a3a2a"/>`;
    } else if (on(1)) { const t = P(ox + 5, oy + 5, 2.6); s += `<text x="${f1(t[0])}" y="${f1(t[1])}" font-size="26" text-anchor="middle">🚧</text>`; }
    const tt = tb - H;
    if (on(3)) s += `<ellipse cx="${bx}" cy="${f1(tt)}" rx="17" ry="4" fill="#2a2a30"/><rect x="${f1(b0[0] - 10)}" y="${f1(tt - 20)}" width="20" height="20" fill="${on(4) ? "#fff6a0" : "#bfe0f0"}" stroke="#2a2a30" stroke-width="2"/><path d="M${f1(b0[0] - 13)} ${f1(tt - 20)} Q${bx} ${f1(tt - 38)} ${f1(b0[0] + 13)} ${f1(tt - 20)} Z" fill="#c8312b" stroke="#8a1e18"/><line x1="${bx}" y1="${f1(tt - 34)}" x2="${bx}" y2="${f1(tt - 44)}" stroke="#2a2a30" stroke-width="2"/>`;
    if (on(4)) s += `<g style="pointer-events:none"><path d="M${f1(b0[0] + 8)} ${f1(tt - 12)} L${f1(b0[0] + 150)} ${f1(tt - 52)} L${f1(b0[0] + 150)} ${f1(tt + 22)} Z" fill="#fff6a0" opacity=".4"><animate attributeName="opacity" values=".08;.5;.08" dur="3s" repeatCount="indefinite"/></path><path d="M${f1(b0[0] - 8)} ${f1(tt - 12)} L${f1(b0[0] - 150)} ${f1(tt - 50)} L${f1(b0[0] - 150)} ${f1(tt + 24)} Z" fill="#fff6a0" opacity=".4"><animate attributeName="opacity" values=".5;.08;.5" dur="3s" repeatCount="indefinite"/></path><circle cx="${bx}" cy="${f1(tt - 10)}" r="14" fill="#fff6a0" opacity=".5"/></g>`;
    if (on(5)) s += [[-70, -60, "#ff4f8b"], [0, -100, "#ffd23a"], [70, -50, "#3ab0ff"]].map(([dx, dy, col]) => `<g transform="translate(${f1(b0[0] + dx)} ${f1(tt + dy)})" stroke="${col}" stroke-width="3" stroke-linecap="round">${[0, 45, 90, 135, 180, 225, 270, 315].map(a => `<path d="M0 0 L${f1(Math.cos(a * Math.PI / 180) * 22)} ${f1(Math.sin(a * Math.PI / 180) * 22)}"/>`).join("")}</g>`).join("");
    const lb = P(ox + 5, oy + 5, 0);
    plaza.label = `<g style="pointer-events:none" transform="translate(${f1(lb[0])} ${f1(lb[1] + 34)})"><rect x="-100" y="-14" width="200" height="${meta == null ? 26 : 44}" rx="8" fill="#1d2a4a" opacity=".9"/><text y="4" font-family="Arial Black,Arial" font-size="15" fill="#ffd23a" text-anchor="middle">EL FARO DEL CURSO</text>${meta == null ? "" : `<text y="23" font-family="Arial" font-weight="700" font-size="13" fill="#fff" text-anchor="middle">${m.toLocaleString("es-ES")} 🪙 · META COMÚN</text>`}</g>`;
    return s;
  }

  /* ---------- Stadt v2: Häuser entlang geschwungener Straßen, Weser, in der Mitte der Faro del curso ---------- */
  function townSVG2(list, meta) {
    const n = list.length + 1, rnd = rng(n * 13 + 5), G = 12.5;
    const perSide = Math.max(3, Math.ceil(Math.sqrt(n * 1.6) / 1.2)), perBand = perSide * 2, bands = Math.ceil(n / perBand);
    const BH = 29; // Abstand der Straßen
    const curve = (k, x) => 3.2 * Math.sin(x / 14 + k * 1.7) + 1.4 * Math.sin(x / 6.5 + k);
    const lots = []; // {x,y}
    for (let b = 0; b < bands; b++) for (let c = 0; c < perSide; c++) {
      const x = c * G + (b % 2 ? 6 : 0) + (rnd() - .5) * 1.4, yc = b * BH + curve(b, x + 5);
      lots.push({ x: x, y: yc - 11.6 - rnd() * 1.2 }); lots.push({ x: x + (rnd() - .5) * 1.2, y: yc + 1.6 + rnd() * 1.2 });
    }
    const use = lots.slice(0, n), pIdx = Math.min(use.length - 1, (Math.floor((bands - 1) / 2) * perBand) + Math.floor(perSide / 2) * 2);
    const xs0 = use.map(l => l.x), ys0 = use.map(l => l.y), minX = Math.min(...xs0) - 4, maxX = Math.max(...xs0) + 14, minY = Math.min(...ys0) - 4, maxY = Math.max(...ys0) + 14;
    const cx = (minX + maxX) / 2, cy = (minY + maxY) / 2, ax = (maxX - minX) / 2 + 9, ay = (maxY - minY) / 2 + 9;
    let s = "";
    const blob = []; for (let k = 0; k < 44; k++) { const t = k / 44 * Math.PI * 2, r = 1 + .07 * Math.sin(t * 3 + 2) + .05 * Math.sin(t * 7) + (rnd() - .5) * .05; blob.push([cx + Math.cos(t) * ax * r, cy + Math.sin(t) * ay * r, 0]); }
    s += poly(blob.map(q => [q[0] + 1.2, q[1] + 1.2, -1.2]), "#0a1a28", 'opacity=".55"') + poly(blob, "#6aa84f") + poly(blob.map(q => [cx + (q[0] - cx) * .93, cy + (q[1] - cy) * .93, .005]), "#74b356");
    // Weser
    const rx = y => maxX + 5 + 2.2 * Math.sin(y / 9) + 1.2 * Math.sin(y / 4.3), L = [], Rr = [];
    for (let y = minY - 14; y <= maxY + 14; y += 1.5) { L.push([rx(y) - 2.1, y, .02]); Rr.unshift([rx(y) + 2.1, y, .02]); }
    s += `<clipPath id="isl2"><polygon points="${pts(blob)}"/></clipPath><g clip-path="url(#isl2)">` + poly(L.concat(Rr), "#4a8ec4", 'stroke="#c9b98a" stroke-width="4"');
    for (let y = minY - 10; y < maxY + 10; y += 6) s += ln([rx(y) - .8, y, .03], [rx(y + 1.2) + .6, y + 1.2, .03], "#fff", 2, 'opacity=".45"');
    s += `</g>`;
    s += `<g clip-path="url(#isl2)">`;
    // Geschwungene Straßen (Band b)
    const strip = (pts0, w, c, ex) => { const A = [], B = []; for (let i = 0; i < pts0.length; i++) { const p = pts0[i], q = pts0[Math.min(i + 1, pts0.length - 1)], o = pts0[Math.max(i - 1, 0)], dx = q[0] - o[0], dy = q[1] - o[1], l = Math.hypot(dx, dy) || 1; A.push([p[0] - dy / l * w, p[1] + dx / l * w, .015]); B.unshift([p[0] + dy / l * w, p[1] - dx / l * w, .015]); } return poly(A.concat(B), c, ex); };
    for (let b = 0; b < bands; b++) { const P0 = []; for (let x = minX - 2; x <= maxX + 3; x += 1) P0.push([x, b * BH + curve(b, x)]);
      s += strip(P0, 1.9, "#c4bca8") + strip(P0, 1.35, "#4b515a");
      for (let i = 0; i < P0.length - 2; i += 3) s += ln([P0[i][0], P0[i][1], .03], [P0[i + 1][0], P0[i + 1][1], .03], "#f3e7b0", 2, 'opacity=".8"'); }
    // Verbindungswege zwischen den Straßen (Feldwege)
    for (let b = 0; b < bands - 1; b++) { const x = minX + (maxX - minX) * (b % 2 ? .25 : .7), P0 = []; for (let t = 0; t <= 1.001; t += .1) P0.push([x + 2.5 * Math.sin(t * Math.PI), b * BH + curve(b, x) + t * (BH + curve(b + 1, x) - curve(b, x))]); s += strip(P0, .8, "#c2aa7a"); }
    // Brücke
    const by = Math.floor(bands / 2) * BH, bc = by + curve(Math.floor(bands / 2), maxX); const P1 = []; for (let x = maxX + 2; x <= rx(bc) + 3; x += 1) P1.push([x, bc]); s += strip(P1, .9, "#c2aa7a") + blk(rx(bc) - 2.6, bc - 1, .05, 5.2, 2, .35, "#b08a5a");
    // Felder
    [[minX - 5, minY + 6], [maxX - 12, minY - 4], [minX + 6, maxY + 2]].forEach(([fx, fy], k) => { s += poly([[fx, fy, .01], [fx + 7, fy, .01], [fx + 7, fy + 5, .01], [fx, fy + 5, .01]], ["#d8c06a", "#b8a050", "#c9d48a"][k]); for (let r = .6; r < 5; r += .8) s += ln([fx + .2, fy + r, .02], [fx + 6.8, fy + r, .02], "#a08a3a", 1.2, 'opacity=".5"'); });
    s += `</g>`;
    // Objekte
    const obj = []; let k = 0;
    use.forEach((l, idx) => { const o = P(l.x, l.y, 0);
      if (idx === pIdx) { obj.push({ d: l.x + l.y + 10, s: `<g>${plaza(l.x, l.y, meta)}</g>` }); return; }
      const h = list[k]; if (!h) return; obj.push({ d: l.x + l.y + 10, s: `<g class="lot" data-k="${k}" style="cursor:pointer" transform="translate(${f1(o[0])} ${f1(o[1])})">${houseSVG(h.h, h.st, { nr: h.nr, inner: true })}</g>` }); k++; });
    const freeAt = (x, y) => !use.some(l => x > l.x - .8 && x < l.x + 10.8 && y > l.y - .8 && y < l.y + 10.8) && Math.abs(x - rx(y)) > 3.2 && [...Array(bands).keys()].every(b => Math.abs(y - b * BH - curve(b, x)) > 2.3);
    const inside = (x, y) => { const dx = (x - cx) / ax, dy = (y - cy) / ay; return dx * dx + dy * dy < .86; };
    for (let q = 0; q < 140; q++) { const x = cx + (rnd() * 2 - 1) * ax, y = cy + (rnd() * 2 - 1) * ay; if (inside(x, y) && freeAt(x, y)) obj.push({ d: x + y, s: tree(x, y, .6 + rnd() * .6) }); }
    for (let b = 0; b < bands; b++) for (let x = minX; x < maxX; x += 9 + rnd() * 6) { const y = b * BH + curve(b, x); if (rnd() < .6) obj.push({ d: x + y, s: lamp(x, y - 1.7) }); if (rnd() < .22) obj.push({ d: x + y + 1, s: car(x, y - 1.05, ["#e63946", "#3a78d8", "#f0c03a", "#f4f1ea", "#3aa06a"][Math.floor(rnd() * 5)], true) }); }
    obj.sort((a, b) => a.d - b.d).forEach(o => { s += o.s; });
    s += plaza.label || "";
    const NR = ["Calle Mayor", "Rúa do Franco", "Calle del Sol", "Calle del Ciervo", "Calle de Galicia"];
    for (let b = 0; b < bands; b++) { const x = minX + 3, t = P(x, b * BH + curve(b, x), .05); s += `<text x="${f1(t[0])}" y="${f1(t[1]) + 4}" font-family="Arial" font-weight="700" font-size="11" fill="#fff" text-anchor="start" transform="rotate(30 ${f1(t[0])} ${f1(t[1])})">${NR[b % NR.length]}</text>`; }
    const pb = blob.map(q => P(q[0], q[1], 0)), X = [Math.min(...pb.map(p => p[0])) - 20, Math.max(...pb.map(p => p[0])) + 20], Y = [Math.min(...pb.map(p => p[1])) - 200, Math.max(...pb.map(p => p[1])) + 40];
    return `<svg viewBox="${f1(X[0])} ${f1(Y[0])} ${f1(X[1] - X[0])} ${f1(Y[1] - Y[0])}" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%;height:auto">${s}</svg>`;
  }

  window.HOUSE = { CATALOG: HCAT, SLOTS: HSLOTS, DEFAULT: HDEFAULT, STAGES: STAGES, YARD_STAGE: YARD_STAGE, STAGE_NAMES: STAGE_NAMES, TABS: HTABS, SLOTNAME: HSLOTNAME,
    item: id => byId[id], clean: hclean, stageOf: stageOf, yardOpen: yardOpen, svg: houseSVG, town: townSVG, town2: townSVG2, fam: fam };
})();
